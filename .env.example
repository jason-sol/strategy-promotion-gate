# Alpaca API credentials — generate from the Alpaca dashboard.
# Paper trading keys: https://app.alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper-api.alpaca.markets (safe). Only set false after >=2 weeks of paper trading.
ALPACA_PAPER=true

# Daily email briefings (optional — briefings stay off until these are set).
# GMAIL_APP_PASSWORD is a Google App Password (myaccount.google.com/apppasswords,
# requires 2-Step Verification), NOT your normal account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Defaults to GMAIL_ADDRESS when empty.
BRIEFING_TO=

# Remote commands by email (halt / clear-halt / force-exit / status). The channel
# stays off until this AND the Gmail credentials above are set. Use a long random
# string of its own — never the app password: mailbox read access must not confer
# command authority. Subject format and how to sign one: bot/commands.py.
COMMAND_SECRET=

# Finnhub earnings data for the dormant PEAD sleeve (signal-logging only).
# Free key: https://finnhub.io/dashboard. Free tier is NOT point-in-time
# (current consensus, ~4 quarters history), so the sleeve stays out of the
# live lineup and backtests until enough forward evidence accrues.
FINNHUB_API_KEY=
